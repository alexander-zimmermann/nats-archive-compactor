{
  // --- Editor Behavior ---
  "editor.rulers": [100],

  // --- Python Tooling (aligned with pyproject.toml) ---
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.typeCheckingMode": "strict",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // Pin Mypy to the project venv so dev-deps are visible.
  "mypy-type-checker.path": ["${workspaceFolder}/.venv/bin/dmypy"],
  "mypy-type-checker.importStrategy": "fromEnvironment",
  // The extension's own server crashes on Python 3.15 (microsoft/vscode-mypy#635).
  "mypy-type-checker.interpreter": ["${userHome}/.local/bin/python3.14"],

  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },

  // --- File Associations ---
  "files.associations": {
    "**/*.yaml.j2": "yaml"
  },

  // --- Material Icon Theme - Color Saturation ---
  "material-icon-theme.saturation": 0.5,

  // --- Material Icon Theme - Default Folder Color ---
  "material-icon-theme.folders.color": "#42a5f5",

  // --- Material Icon Theme - Folder Mapping ---
  "material-icon-theme.folders.associations": {}
}
